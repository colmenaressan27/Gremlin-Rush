{
  "name": "gremlin-rush",
  "private": true,
  "version": "0.1.0",
  "description": "GREMLIN RUSH — arcade WebAR controlado con la mano (fase P0: factibilidad)",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "postinstall": "node scripts/prepare-assets.mjs --soft",
    "dev": "vite",
    "dev:movil": "vite --mode movil",
    "dev:tunel": "vite --mode tunel",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:movil": "vite preview --mode movil",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.2",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
